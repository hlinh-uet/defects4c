# Slim benchmark image for defectsc_tpl/projects/mongodb___mongo-c-driver.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update -yq && \
    apt-get install -yq --no-install-recommends \
      build-essential gcc g++ \
      cmake ninja-build pkg-config \
      python3 \
      git ca-certificates \
      jq \
      findutils coreutils grep sed diffutils gawk \
      procps util-linux bash \
      tzdata && \
    apt-get autoremove -y && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY defectsc_tpl/projects/mongodb___mongo-c-driver/run_mongo_c_driver_build.py \
     /usr/local/bin/defects4c-mongo-c-driver-build
COPY defectsc_tpl/projects/mongodb___mongo-c-driver/run_mongo_c_driver_tests.py \
     /usr/local/bin/defects4c-mongo-c-driver-test
RUN chmod 0755 /usr/local/bin/defects4c-mongo-c-driver-build \
               /usr/local/bin/defects4c-mongo-c-driver-test

WORKDIR /src
CMD ["bash"]
