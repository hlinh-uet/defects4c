# Dedicated build/test image for Defects4C llvm___llvm-project cases.
#
# The benchmark spans LLVM revisions from 2014 through 2023. Ubuntu 20.04
# provides Python 2 for the oldest lit revisions, while a pinned modern CMake
# from PyPI can still configure the newest revisions in the dataset.
#
# Build from the defects4c root:
#   docker build -f Dockerfile.llvm -t llvm/defect4c:latest .
FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive \
    AM_I_IN_A_DOCKER_CONTAINER=Yes \
    TZ=UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    HOME=/tmp \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CCACHE_DIR=/tmp/ccache

RUN apt-get update -yq && \
    apt-get install -yq --no-install-recommends \
      build-essential gcc g++ \
      python2-minimal python3 python3-pip python3-setuptools \
      git ca-certificates \
      ccache lld \
      zlib1g-dev libzstd-dev libxml2-dev libedit-dev \
      libffi-dev libncurses5-dev libtinfo-dev \
      swig pkg-config \
      jq findutils coreutils grep sed diffutils gawk \
      util-linux bash tzdata && \
    apt-get autoremove -y && apt-get clean && rm -rf /var/lib/apt/lists/*

# CMake 3.27 supports the newest benchmark revisions and remains compatible
# with the historical LLVM CMake projects. Ninja from PyPI avoids distro-version
# differences when the image is rebuilt later.
RUN python3 -m pip install --no-cache-dir \
      cmake==3.27.9 \
      ninja==1.11.1.1 \
      jinja2 \
      jmespath && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3 30 && \
    update-alternatives --install /usr/bin/python python /usr/bin/python2 20

COPY defectsc_tpl/projects_v1/llvm___llvm-project/run_llvm_lit.py \
     /usr/local/bin/defects4c-llvm-lit
RUN chmod 0755 /usr/local/bin/defects4c-llvm-lit

WORKDIR /src

CMD ["bash"]
