# ──────────────────────────────────────────────────────────────────────
# Dockerfile.libyang — image slim cho Defects4C project CESNET___libyang
#
# libyang dùng CMake + Ninja, cần thư viện PCRE2 và CMocka cho unit test.
# Image chỉ cài toolchain C, cmake, ninja, pcre2, cmocka, gcov, python3.
#
# Image kỳ vọng: ~400–600 MB.
#
# Build:
#   docker build -f Dockerfile.libyang -t libyang/defect4c:latest .
#
# Run:
#   docker run -d --name my_defects4c_libyang \
#     --ipc=host \
#     -v "$(pwd)/defectsc_tpl:/src" \
#     -v "$(pwd)/out_tmp_dirs:/out" \
#     -v "$(pwd)/patche_dirs:/patches" \
#     -v "$(pwd)/unified_debugging:/unified_debugging" \
#     -v "$(pwd)/../Unified-Debugging:/udbg" \
#     libyang/defect4c:latest sleep infinity
# ──────────────────────────────────────────────────────────────────────
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    AM_I_IN_A_DOCKER_CONTAINER=Yes \
    TZ=UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    HOME=/tmp \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Toolchain tối thiểu cho libyang + helper scripts Defects4C.
#   - cmake, ninja-build: build system
#   - libpcre2-dev: bắt buộc cho libyang
#   - libcmocka-dev: unit test framework (CMocka)
#   - gcc, g++, gcov: compiler + coverage
#   - flex, bison: parser generators needed by historical revisions
# Valgrind tests are explicitly disabled by the Debugging-Framework contract.
RUN apt-get update -yq && \
    apt-get install -yq --no-install-recommends \
      build-essential make gcc g++ \
      cmake ninja-build \
      flex bison \
      pkg-config \
      libpcre2-dev \
      libpcre3-dev \
      libcmocka-dev \
      git ca-certificates \
      jq \
      findutils coreutils grep sed diffutils gawk \
      util-linux bash \
      python3 python3-pip \
      tzdata && \
    apt-get autoremove -y && apt-get clean && rm -rf /var/lib/apt/lists/*

# Python deps tối thiểu cho build_meta_libyang.py
RUN pip3 install --no-cache-dir jinja2 jmespath

# Mount points khớp với README:
#   /src               ← defectsc_tpl (script, projects_v1/*, templates)
#   /out               ← out_tmp_dirs (clone + logs)
#   /patches           ← patche_dirs (apr patches)
#   /unified_debugging ← unified_debugging (metadata + raw output)
#   /udbg              ← Unified-Debugging code
WORKDIR /src

CMD ["bash"]
