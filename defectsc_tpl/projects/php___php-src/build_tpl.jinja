build_dir=$1


bison_path=$(realpath "../dep_dirs")
mkdir -p $bison_path

if [[ ! -d $bison_path"/bison-2.7/bison-2.7_bin" ]]; then 
	cur_dir=$(pwd)	

	wget https://ftp.gnu.org/gnu/bison/bison-2.7.tar.gz -P  $bison_path
	cd $bison_path 

	tar -xf bison-2.7.tar.gz 

	cd "bison-2.7"

	git apply /src/projects/php___php-src/bison-2.7-glibc-change-work-around.patch


	./configure --prefix=`pwd`/bison-2.7_bin

	make -j $(nproc)

	make install 

	cd $cur_dir
fi 


export PATH=$bison_path"/bison-2.7/bison-2.7_bin/bin/":$PATH

#TS="--enable-maintainer-zts";
#DEBUG="--enable-debug";


build_flags=" {% for option in build_flags %}{{ option }} {% endfor %} ";



{% if not is_rebuild %}
	./buildconf --force
	
	./configure \
	--quiet \
	$build_flags \
	--enable-phpdbg \
	--enable-fpm \
	--without-pear \
	--enable-sysvsem \
	--enable-sysvshm \
	--enable-shmop \
	--enable-pcntl \
	--enable-mbstring \
	 --enable-shared=Yes \
	  --enable-static=No \
	CFLAGS="-Wno-error" CXX=g++ CC=gcc   

{% endif %}



make -j {{ cpu_count }} 


