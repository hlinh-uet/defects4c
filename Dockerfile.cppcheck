# Dockerfile.cppcheck -- slim image for Defects4C project danmar___cppcheck
#
# Build:
#   docker build -f Dockerfile.cppcheck -t cppcheck/defect4c:latest .
#
# Run:
#   docker run -d --name my_defects4c_cppcheck \
#     --ipc=host \
#     -v "$(pwd)/defectsc_tpl:/src" \
#     -v "$(pwd)/out_tmp_dirs:/out" \
#     -v "$(pwd)/patche_dirs:/patches" \
#     -v "$(pwd)/unified_debugging:/unified_debugging" \
#     -v "$(pwd)/../Unified-Debugging:/udbg" \
#     cppcheck/defect4c:latest sleep infinity

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    AM_I_IN_A_DOCKER_CONTAINER=Yes \
    TZ=UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update -yq && \
    apt-get install -yq --no-install-recommends \
      build-essential make gcc g++ \
      cmake ninja-build ccache \
      pkg-config \
      libpcre3-dev libpcre2-dev \
      libtinyxml2-dev libxml2-dev \
      sqlite3 libsqlite3-dev \
      git ca-certificates \
      jq \
      findutils coreutils grep sed diffutils gawk \
      util-linux bash \
      python3 python3-pip python3-pygments \
      tzdata && \
    apt-get autoremove -y && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir jinja2 jmespath

WORKDIR /src

CMD ["bash"]
